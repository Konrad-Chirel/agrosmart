APP_NAME=AgroSmart
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=file

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=agrosmart_backend

OPENWEATHER_API_KEY=
FIREBASE_SERVER_KEY=

RESERVOIR_CAPACITE_LITRES=1000
RESERVOIR_SEUIL_ALERTE_PCT=15

MAIL_MAILER=log
MAIL_FROM_ADDRESS="backend@agrosmart.local"
MAIL_FROM_NAME="${APP_NAME}"
